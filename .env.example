# Copy to .env (never commit it) or set these in your host's environment.

# Signs session tokens. Required in production; without it a random key is
# generated at startup and everyone is signed out on every restart.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite by default. For Postgres: postgresql+psycopg://user:pass@host:5432/smartlearn
DATABASE_URL=sqlite:///./smartlearn.db

# 1 = only send the session cookie over HTTPS. Set to 1 in production.
COOKIE_SECURE=0

# Days a sign-in lasts
SESSION_DAYS=7

# 1 = run `alembic upgrade head` when the API starts
AUTO_MIGRATE=1
